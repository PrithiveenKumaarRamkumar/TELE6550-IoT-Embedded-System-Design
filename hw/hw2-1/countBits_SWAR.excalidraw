    {
      "id": "text-0193",
      "type": "text",
      "x": 1344,
      "y": 1070.5,
      "width": 501.12,
      "height": 30.0,
      "angle": 0,
      "strokeColor": "#e8590c",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "grp-0191"
      ],
      "frameId": null,
      "index": "b1x",
      "roundness": null,
      "seed": 1564914658,
      "version": 1,
      "versionNonce": 2135093075,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1790467200000,
      "link": null,
      "locked": false,
      "text": "Step 3 · add nibbles into 8-bit counts (bytes)",
      "fontSize": 24,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Step 3 · add nibbles into 8-bit counts (bytes)",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "text-0194",
      "type": "text",
      "x": 1344,
      "y": 1110.5,
      "width": 495.9,
      "height": 112.5,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "grp-0191"
      ],
      "frameId": null,
      "index": "b1y",
      "roundness": null,
      "seed": 2100189573,
      "version": 1,
      "versionNonce": 690873469,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1790467200000,
      "link": null,
      "locked": false,
      "text": "Same idea, but one mask is enough: a nibble count is at\nmost 4, so two of them add up to at most 8 = 1000b, which\nstill fits in 4 bits. Nothing can carry into the next\nnibble, so add first and mask once: 0x0F0F0F0F clears\nthe leftover upper nibbles.",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Same idea, but one mask is enough: a nibble count is at\nmost 4, so two of them add up to at most 8 = 1000b, which\nstill fits in 4 bits. Nothing can carry into the next\nnibble, so add first and mask once: 0x0F0F0F0F clears\nthe leftover upper nibbles.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "text-0195",
      "type": "text",
      "x": 1344,
      "y": 1235.0,
      "width": 487.47,
      "height": 40.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "grp-0191"
      ],
      "frameId": null,
      "index": "b1z",
      "roundness": null,
      "seed": 2586736,
      "version": 1,
      "versionNonce": 62150639,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1790467200000,
      "link": null,
      "locked": false,
      "text": "  x + (x >> 4)           0x12333454\n& 0x0F0F0F0F             0x02030404   bytes: 2 3 4 4",
      "fontSize": 16,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "  x + (x >> 4)           0x12333454\n& 0x0F0F0F0F             0x02030404   bytes: 2 3 4 4",
      "autoResize": true,
      "lineHeight": 1.25
    },
