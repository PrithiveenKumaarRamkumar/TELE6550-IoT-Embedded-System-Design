      ],
      "frameId": null,
      "index": "b0K",
      "roundness": null,
      "seed": 2076314232,
      "version": 1,
      "versionNonce": 872875726,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1790467200000,
      "link": null,
      "locked": false,
      "text": "13 of the 32 bits are 1",
      "fontSize": 14,
      "fontFamily": 3,
      "textAlign": "left",
