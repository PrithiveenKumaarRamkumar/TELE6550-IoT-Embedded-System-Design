      "backgroundColor": "#f8f9fa",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "grp-0224"
      ],
      "frameId": null,
      "index": "b2P",
      "roundness": {
        "type": 3
      },
      "seed": 335316920,
      "version": 1,
      "versionNonce": 1077320957,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1790467200000,
      "link": null,
      "locked": false
    },
    {
      "id": "text-0226",
      "type": "text",
      "x": 1344,
      "y": 1668.5,
      "width": 150.24,
      "height": 30.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "grp-0224"
      ],
      "frameId": null,
      "index": "b2Q",
      "roundness": null,
      "seed": 881425977,
      "version": 1,
      "versionNonce": 1843491723,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1790467200000,
      "link": null,
      "locked": false,
      "text": "Why it is fast",
      "fontSize": 24,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Why it is fast",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "text-0227",
      "type": "text",
      "x": 1344,
      "y": 1708.5,
      "width": 502.74,
      "height": 157.5,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "grp-0224"
      ],
      "frameId": null,
      "index": "b2R",
      "roundness": null,
      "seed": 1399051350,
      "version": 1,
      "versionNonce": 1572090771,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1790467200000,
      "link": null,
      "locked": false,
      "text": "• about 12 simple operations: shifts, ANDs, adds,\n   one subtract and one multiply\n• no loops, no ifs: 0 takes the same time as 0xFFFFFFFF\n• the ESP32 has a hardware multiplier, so step 4 is cheap\n• why not __builtin_popcount? The ESP32 has no bit-count\n   instruction, so the compiler turns it into a call to a\n   library routine, which is slower than these inline steps",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "• about 12 simple operations: shifts, ANDs, adds,\n   one subtract and one multiply\n• no loops, no ifs: 0 takes the same time as 0xFFFFFFFF\n• the ESP32 has a hardware multiplier, so step 4 is cheap\n• why not __builtin_popcount? The ESP32 has no bit-count\n   instruction, so the compiler turns it into a call to a\n   library routine, which is slower than these inline steps",
      "autoResize": true,
      "lineHeight": 1.25
    },
