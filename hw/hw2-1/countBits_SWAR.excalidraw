    {
      "id": "text-0153",
      "type": "text",
      "x": 1344,
      "y": 764.0,
      "width": 494.64,
      "height": 30.0,
      "angle": 0,
      "strokeColor": "#2f9e44",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "grp-0151"
      ],
      "frameId": null,
      "index": "b1M",
      "roundness": null,
      "seed": 1786355788,
      "version": 1,
      "versionNonce": 1392955335,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1790467200000,
      "link": null,
      "locked": false,
      "text": "Step 2 · add pairs into 4-bit counts (nibbles)",
      "fontSize": 24,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Step 2 · add pairs into 4-bit counts (nibbles)",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "text-0154",
      "type": "text",
      "x": 1344,
      "y": 804.0,
      "width": 516.96,
      "height": 112.5,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "grp-0151"
      ],
      "frameId": null,
      "index": "b1N",
      "roundness": null,
      "seed": 1217598568,
      "version": 1,
      "versionNonce": 911683178,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1790467200000,
      "link": null,
      "locked": false,
      "text": "0x33333333 = 0011 0011 … keeps the low pair of each nibble;\nshifting right by 2 first brings the high pair down to it.\nMask BOTH halves before adding: 2 + 2 = 4 = 100b needs\n3 bits, more than a 2-bit slot holds. Without the masks\nthe sum would spill into the neighbouring slot.",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "0x33333333 = 0011 0011 … keeps the low pair of each nibble;\nshifting right by 2 first brings the high pair down to it.\nMask BOTH halves before adding: 2 + 2 = 4 = 100b needs\n3 bits, more than a 2-bit slot holds. Without the masks\nthe sum would spill into the neighbouring slot.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "text-0155",
      "type": "text",
      "x": 1344,
      "y": 928.5,
      "width": 449.97,
      "height": 60.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "grp-0151"
      ],
      "frameId": null,
      "index": "b1O",
      "roundness": null,
      "seed": 2058007670,
      "version": 1,
      "versionNonce": 510912737,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1790467200000,
      "link": null,
      "locked": false,
      "text": "  x & 0x33333333         0x11201120   low pairs\n+ (x >> 2) & 0x33333333  0x00011111   high pairs\n= 8 nibble counts        0x11212231",
      "fontSize": 16,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "  x & 0x33333333         0x11201120   low pairs\n+ (x >> 2) & 0x33333333  0x00011111   high pairs\n= 8 nibble counts        0x11212231",
      "autoResize": true,
      "lineHeight": 1.25
    },
