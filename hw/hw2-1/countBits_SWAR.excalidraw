      "seed": 713355861,
      "version": 1,
      "versionNonce": 949359665,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1790467200000,
      "link": null,
      "locked": false,
      "text": "Row + column = n, e.g. 0x30 + 5 = 0x35 = 53, which has 4 ones.\nDarker yellow = more 1-bits.  count(0xAB) = count(A) + count(B):\nadding up the parts, just like SWAR does.",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Row + column = n, e.g. 0x30 + 5 = 0x35 = 53, which has 4 ones.\nDarker yellow = more 1-bits.  count(0xAB) = count(A) + count(B):\nadding up the parts, just like SWAR does.",
      "autoResize": true,
      "lineHeight": 1.25
    },
