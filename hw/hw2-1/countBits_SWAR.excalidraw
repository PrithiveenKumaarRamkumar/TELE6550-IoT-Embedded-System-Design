      "updated": 1790467200000,
      "link": null,
      "locked": false,
      "text": "countBits(0)          ->  0\ncountBits(255)        ->  8\ncountBits(0x12345678) -> 13\ncountBits(0xFFFFFFFF) -> 32",
      "fontSize": 16,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "countBits(0)          ->  0\ncountBits(255)        ->  8\ncountBits(0x12345678) -> 13\ncountBits(0xFFFFFFFF) -> 32",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "text-0304",
      "type": "text",
      "x": 344,
      "y": 2486.0,
      "width": 469.08,
      "height": 45.0,
      "angle": 0,
      "strokeColor": "#495057",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "grp-0300"
      ],
      "frameId": null,
      "index": "b3c",
      "roundness": null,
      "seed": 388071454,
      "version": 1,
      "versionNonce": 980097472,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1790467200000,
      "link": null,
      "locked": false,
      "text": "All 256 counts printed for 0 … 255 add up to 1024:\neach of the 8 low bits is 1 in exactly half (128) of them.",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "All 256 counts printed for 0 … 255 add up to 1024:\neach of the 8 low bits is 1 in exactly half (128) of them.",
      "autoResize": true,
      "lineHeight": 1.25
    },
