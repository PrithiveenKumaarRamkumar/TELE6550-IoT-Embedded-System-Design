    {
      "id": "text-0005",
      "type": "text",
      "x": 1344,
      "y": 138,
      "width": 95.76,
      "height": 30.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
