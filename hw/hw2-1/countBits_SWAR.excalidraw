      "version": 1,
      "versionNonce": 319388913,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1790467200000,
      "link": null,
      "locked": false,
      "text": "Putting it together (C for the ESP32)",
      "fontSize": 24,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Putting it together (C for the ESP32)",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "text-0299",
      "type": "text",
      "x": 44,
      "y": 2004.0,
      "width": 824.95,
      "height": 380.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "grp-0296"
      ],
      "frameId": null,
      "index": "b3Y",
      "roundness": null,
      "seed": 1464024146,
      "version": 1,
      "versionNonce": 1881768486,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1790467200000,
      "link": null,
      "locked": false,
      "text": "#include <stdint.h>\n#include <stdio.h>\n\nint countBits(uint32_t integer)\n{\n    integer = integer - ((integer >> 1) & 0x55555555u);                 /* 2-bit sums */\n    integer = (integer & 0x33333333u) + ((integer >> 2) & 0x33333333u); /* 4-bit sums */\n    integer = (integer + (integer >> 4)) & 0x0F0F0F0Fu;                 /* 8-bit sums */\n    return (int)((integer * 0x01010101u) >> 24);                        /* add bytes  */\n}\n\n/* ESP-IDF: call it from app_main().  Arduino: call it from setup()\n   after Serial.begin(115200), and use Serial.printf instead of printf. */\nvoid printAllCounts(void)\n{\n    for (int n = 0; n <= 255; n++) {\n        printf(\"%3d -> %d\\n\", n, countBits((uint32_t)n));\n    }\n}",
      "fontSize": 16,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "#include <stdint.h>\n#include <stdio.h>\n\nint countBits(uint32_t integer)\n{\n    integer = integer - ((integer >> 1) & 0x55555555u);                 /* 2-bit sums */\n    integer = (integer & 0x33333333u) + ((integer >> 2) & 0x33333333u); /* 4-bit sums */\n    integer = (integer + (integer >> 4)) & 0x0F0F0F0Fu;                 /* 8-bit sums */\n    return (int)((integer * 0x01010101u) >> 24);                        /* add bytes  */\n}\n\n/* ESP-IDF: call it from app_main().  Arduino: call it from setup()\n   after Serial.begin(115200), and use Serial.printf instead of printf. */\nvoid printAllCounts(void)\n{\n    for (int n = 0; n <= 255; n++) {\n        printf(\"%3d -> %d\\n\", n, countBits((uint32_t)n));\n    }\n}",
      "autoResize": true,
      "lineHeight": 1.25
    },
