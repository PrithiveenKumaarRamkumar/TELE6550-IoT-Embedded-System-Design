    },
    {
      "id": "text-0088",
      "type": "text",
      "x": 1344,
      "y": 395.0,
      "width": 325.68,
      "height": 30.0,
      "angle": 0,
      "strokeColor": "#1971c2",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "grp-0086"
      ],
      "frameId": null,
      "index": "b0M",
      "roundness": null,
      "seed": 1632594976,
      "version": 1,
      "versionNonce": 1856210714,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1790467200000,
      "link": null,
      "locked": false,
      "text": "Step 1 · count each 2-bit pair",
      "fontSize": 24,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Step 1 · count each 2-bit pair",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "text-0089",
      "type": "text",
      "x": 1344,
      "y": 435.0,
      "width": 504.9,
      "height": 135.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "grp-0086"
      ],
      "frameId": null,
      "index": "b0N",
      "roundness": null,
      "seed": 209858885,
      "version": 1,
      "versionNonce": 990516588,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1790467200000,
      "link": null,
      "locked": false,
      "text": "A pair with bits a b has the value 2a + b, but the count\nwe want is a + b. The difference is exactly a, so subtract it:\n• x >> 1 shifts each pair's high bit a into its low position\n• & 0x55555555 (0101 0101 …) keeps only those a bits\n• x - that = 2a + b - a = a + b, in all 16 pairs at once\nNo pair borrows from its neighbour: a + b is never below 0.",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "A pair with bits a b has the value 2a + b, but the count\nwe want is a + b. The difference is exactly a, so subtract it:\n• x >> 1 shifts each pair's high bit a into its low position\n• & 0x55555555 (0101 0101 …) keeps only those a bits\n• x - that = 2a + b - a = a + b, in all 16 pairs at once\nNo pair borrows from its neighbour: a + b is never below 0.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "text-0090",
      "type": "text",
      "x": 1344,
      "y": 582.0,
      "width": 187.49,
      "height": 100.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "grp-0086"
      ],
      "frameId": null,
      "index": "b0O",
      "roundness": null,
      "seed": 1555580359,
      "version": 1,
      "versionNonce": 783757362,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1790467200000,
      "link": null,
      "locked": false,
      "text": "pair  value-a  count\n 00    0 - 0     0\n 01    1 - 0     1\n 10    2 - 1     1\n 11    3 - 1     2",
      "fontSize": 16,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "pair  value-a  count\n 00    0 - 0     0\n 01    1 - 0     1\n 10    2 - 1     1\n 11    3 - 1     2",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "text-0091",
      "type": "text",
      "x": 1580,
      "y": 582.0,
      "width": 328.1,
      "height": 60.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "grp-0086"
      ],
      "frameId": null,
      "index": "b0P",
      "roundness": null,
      "seed": 972232846,
      "version": 1,
      "versionNonce": 282725678,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1790467200000,
      "link": null,
      "locked": false,
      "text": "  x                      0x12345678\n- (x >> 1) & 0x55555555  0x01100114\n= 16 pair counts         0x11245564",
      "fontSize": 16,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "  x                      0x12345678\n- (x >> 1) & 0x55555555  0x01100114\n= 16 pair counts         0x11245564",
      "autoResize": true,
      "lineHeight": 1.25
    },
