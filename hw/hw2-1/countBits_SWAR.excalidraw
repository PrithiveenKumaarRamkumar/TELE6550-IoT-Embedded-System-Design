        "grp-0003"
      ],
      "frameId": null,
      "index": "a3",
      "roundness": null,
      "seed": 153108603,
      "version": 1,
      "versionNonce": 166466499,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1790467200000,
      "link": null,
      "locked": false,
      "text": "The idea",
      "fontSize": 24,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "The idea",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "text-0006",
      "type": "text",
      "x": 1344,
      "y": 178.0,
      "width": 480.42,
      "height": 135.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "grp-0003"
      ],
      "frameId": null,
      "index": "a4",
      "roundness": null,
      "seed": 1063248887,
      "version": 1,
      "versionNonce": 868607348,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1790467200000,
      "link": null,
      "locked": false,
      "text": "Don't test the bits one at a time. Treat the 32-bit number\nas 32 tiny counters side by side: each bit already counts\nitself (0 or 1). Each step adds neighbouring counters in\nparallel and doubles their width: 1 → 2 → 4 → 8 bits.\nOne final multiply adds the four 8-bit counters together.\n(In these notes, x is the variable integer.)",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Don't test the bits one at a time. Treat the 32-bit number\nas 32 tiny counters side by side: each bit already counts\nitself (0 or 1). Each step adds neighbouring counters in\nparallel and doubles their width: 1 → 2 → 4 → 8 bits.\nOne final multiply adds the four 8-bit counters together.\n(In these notes, x is the variable integer.)",
      "autoResize": true,
      "lineHeight": 1.25
    },
