      "link": null,
      "locked": false,
      "text": "countBits(uint32_t) with SWAR — “SIMD Within A Register”",
      "fontSize": 40,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "countBits(uint32_t) with SWAR — “SIMD Within A Register”",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "text-0002",
      "type": "text",
      "x": 20,
      "y": 60,
      "width": 1187.8,
      "height": 25.0,
      "angle": 0,
      "strokeColor": "#495057",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "a1",
      "roundness": null,
      "seed": 1044777460,
      "version": 1,
      "versionNonce": 672557973,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1790467200000,
      "link": null,
      "locked": false,
      "text": "Worked example: x = 0x12345678, which has 13 bits set. Follow it from top to bottom; the notes on the right explain each step.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Worked example: x = 0x12345678, which has 13 bits set. Follow it from top to bottom; the notes on the right explain each step.",
      "autoResize": true,
      "lineHeight": 1.25
    },
