    {
      "id": "text-0040",
      "type": "text",
      "x": 1344,
      "y": 692,
      "width": 372.48,
      "height": 30.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
