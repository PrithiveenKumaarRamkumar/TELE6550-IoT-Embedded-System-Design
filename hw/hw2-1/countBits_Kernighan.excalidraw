      "updated": 1790553600000,
      "link": null,
      "locked": false,
      "text": "The code: countBits() + print 0 … 255",
      "fontSize": 24,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "The code: countBits() + print 0 … 255",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "text-0006",
      "type": "text",
      "x": 44,
      "y": 178.0,
      "width": 606.99,
      "height": 402.5,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "grp-0003"
      ],
      "frameId": null,
      "index": "a4",
      "roundness": null,
      "seed": 68604447,
      "version": 1,
      "versionNonce": 459618728,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1790553600000,
      "link": null,
      "locked": false,
      "text": "#include <stdint.h>\n#include <stdio.h>\n\nint countBits(uint32_t integer)\n{\n    int count = 0;\n\n    while (integer != 0) {\n        integer = integer & (integer - 1);   /* remove the lowest 1 bit */\n        count++;\n    }\n\n    return count;\n}\n\n/* ESP-IDF: call it from app_main().  Arduino: call it from setup()\n   after Serial.begin(115200), and use Serial.printf instead of printf. */\nvoid printAllCounts(void)\n{\n    for (int n = 0; n <= 255; n++) {\n        printf(\"%3d -> %d\\n\", n, countBits((uint32_t)n));\n    }\n}",
      "fontSize": 14,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "#include <stdint.h>\n#include <stdio.h>\n\nint countBits(uint32_t integer)\n{\n    int count = 0;\n\n    while (integer != 0) {\n        integer = integer & (integer - 1);   /* remove the lowest 1 bit */\n        count++;\n    }\n\n    return count;\n}\n\n/* ESP-IDF: call it from app_main().  Arduino: call it from setup()\n   after Serial.begin(115200), and use Serial.printf instead of printf. */\nvoid printAllCounts(void)\n{\n    for (int n = 0; n <= 255; n++) {\n        printf(\"%3d -> %d\\n\", n, countBits((uint32_t)n));\n    }\n}",
      "autoResize": true,
      "lineHeight": 1.25
    },
