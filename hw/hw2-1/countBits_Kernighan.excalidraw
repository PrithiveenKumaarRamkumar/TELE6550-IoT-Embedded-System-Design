        "grp-0011"
      ],
      "frameId": null,
      "index": "aA",
      "roundness": null,
      "seed": 1520589522,
      "version": 1,
      "versionNonce": 720439802,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1790553600000,
      "link": null,
      "locked": false,
      "text": "Each pass through the loop removes one 1 bit from the\nnumber, and count records how many were removed.\nWhen the number reaches 0, all the 1s are gone, so count\nis the answer. The trick that removes exactly one 1 bit\n(the lowest one) is  integer & (integer - 1)  - see below.",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Each pass through the loop removes one 1 bit from the\nnumber, and count records how many were removed.\nWhen the number reaches 0, all the 1s are gone, so count\nis the answer. The trick that removes exactly one 1 bit\n(the lowest one) is  integer & (integer - 1)  - see below.",
      "autoResize": true,
      "lineHeight": 1.25
    },
