    {
      "id": "text-0325",
      "type": "text",
      "x": 44,
      "y": 1980.5,
      "width": 75.0,
      "height": 260.0,
      "angle": 0,
      "strokeColor": "#b2f2bb",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "grp-0322"
      ],
      "frameId": null,
      "index": "b42",
      "roundness": null,
      "seed": 695645162,
      "version": 1,
      "versionNonce": 1219569670,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1790553600000,
      "link": null,
      "locked": false,
      "text": "  0 -> 0\n  1 -> 1\n  2 -> 1\n  3 -> 2\n  4 -> 1\n  5 -> 2\n  6 -> 2\n  7 -> 3\n  8 -> 1\n...\n253 -> 7\n254 -> 7\n255 -> 8",
      "fontSize": 16,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "  0 -> 0\n  1 -> 1\n  2 -> 1\n  3 -> 2\n  4 -> 1\n  5 -> 2\n  6 -> 2\n  7 -> 3\n  8 -> 1\n...\n253 -> 7\n254 -> 7\n255 -> 8",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "rect-0327",
