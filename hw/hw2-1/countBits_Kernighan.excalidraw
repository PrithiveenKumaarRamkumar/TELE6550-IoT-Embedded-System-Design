      "isDeleted": false,
      "boundElements": null,
      "updated": 1790553600000,
      "link": null,
      "locked": false
    },
    {
      "id": "text-0328",
      "type": "text",
      "x": 474,
      "y": 1943.5,
      "width": 68.64,
      "height": 30.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
