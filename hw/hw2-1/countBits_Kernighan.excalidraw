      "version": 1,
      "versionNonce": 1562692790,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1790553600000,
      "link": null,
      "locked": false,
      "text": "Why integer & (integer - 1) works",
      "fontSize": 24,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Why integer & (integer - 1) works",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "text-0041",
      "type": "text",
      "x": 1344,
      "y": 732.0,
      "width": 468.72,
      "height": 157.5,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "grp-0038"
      ],
      "frameId": null,
      "index": "aZ",
      "roundness": null,
      "seed": 763934142,
      "version": 1,
      "versionNonce": 540071328,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1790553600000,
      "link": null,
      "locked": false,
      "text": "Subtracting 1 turns the lowest 1 into 0 and turns all the\n0s to its right into 1s (the borrow stops at that 1); the\nbits above it don't change. ANDing with the original:\n• bits above: b & b = b, so they stay as they were\n• the lowest 1: 1 & 0 = 0, so it is cleared\n• the 0s to its right: 0 & 1 = 0, so they stay 0\nResult: exactly one bit, the lowest 1, is removed.",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Subtracting 1 turns the lowest 1 into 0 and turns all the\n0s to its right into 1s (the borrow stops at that 1); the\nbits above it don't change. ANDing with the original:\n• bits above: b & b = b, so they stay as they were\n• the lowest 1: 1 & 0 = 0, so it is cleared\n• the 0s to its right: 0 & 1 = 0, so they stay 0\nResult: exactly one bit, the lowest 1, is removed.",
      "autoResize": true,
      "lineHeight": 1.25
    },
