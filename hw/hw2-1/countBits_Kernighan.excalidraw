      "link": null,
      "locked": false,
      "text": "Write  int countBits(uint32_t integer);  that returns how\nmany bits are 1 in the number, and print the result for\nevery number from 0 to 255.",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Write  int countBits(uint32_t integer);  that returns how\nmany bits are 1 in the number, and print the result for\nevery number from 0 to 255.",
      "autoResize": true,
      "lineHeight": 1.25
    },
