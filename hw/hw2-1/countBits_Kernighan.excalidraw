      "locked": false
    },
    {
      "id": "text-0285",
      "type": "text",
      "x": 1344,
      "y": 1473.5,
      "width": 199.68,
      "height": 30.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "grp-0283"
      ],
      "frameId": null,
      "index": "b3Q",
      "roundness": null,
      "seed": 1189257460,
      "version": 1,
      "versionNonce": 49597202,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1790553600000,
      "link": null,
      "locked": false,
      "text": "Why it is efficient",
      "fontSize": 24,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Why it is efficient",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "text-0286",
      "type": "text",
      "x": 1344,
      "y": 1513.5,
      "width": 454.14,
      "height": 180.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "grp-0283"
      ],
      "frameId": null,
      "index": "b3R",
      "roundness": null,
      "seed": 1050426755,
      "version": 1,
      "versionNonce": 1496146155,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1790553600000,
      "link": null,
      "locked": false,
      "text": "The loop runs once per 1 bit, not once per bit position:\n• 0 takes no passes, and 128 (10000000) takes 1\n• the worst case is 32 passes, for 0xFFFFFFFF,\n   where every bit is set\n• the obvious \"check each of the 32 bits\" loop\n   always takes 32 passes\nFor this task (0 … 255) that is 1024 passes in total,\n4 per number on average, instead of 256 × 32 = 8192.",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "The loop runs once per 1 bit, not once per bit position:\n• 0 takes no passes, and 128 (10000000) takes 1\n• the worst case is 32 passes, for 0xFFFFFFFF,\n   where every bit is set\n• the obvious \"check each of the 32 bits\" loop\n   always takes 32 passes\nFor this task (0 … 255) that is 1024 passes in total,\n4 per number on average, instead of 256 × 32 = 8192.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "text-0288",
      "type": "text",
      "x": 20,
      "y": 1455.5,
      "width": 488.0,
      "height": 25.0,
      "angle": 0,
      "strokeColor": "#495057",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "grp-0287"
      ],
      "frameId": null,
      "index": "b3S",
      "roundness": null,
      "seed": 2078398286,
      "version": 1,
      "versionNonce": 1062219825,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1790553600000,
      "link": null,
      "locked": false,
      "text": "Loop passes: once per 1 bit vs. once per bit position",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Loop passes: once per 1 bit vs. once per bit position",
      "autoResize": true,
      "lineHeight": 1.25
    },
