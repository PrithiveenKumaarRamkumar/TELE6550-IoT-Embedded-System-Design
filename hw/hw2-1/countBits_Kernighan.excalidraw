      "text": "countBits(uint32_t) with Brian Kernighan's method",
      "fontSize": 40,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "countBits(uint32_t) with Brian Kernighan's method",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "text-0002",
      "type": "text",
      "x": 20,
      "y": 60,
      "width": 1526.0,
      "height": 25.0,
      "angle": 0,
      "strokeColor": "#495057",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "a1",
      "roundness": null,
      "seed": 1933714182,
      "version": 1,
      "versionNonce": 601828002,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1790553600000,
      "link": null,
      "locked": false,
      "text": "Each pass of the loop removes the lowest 1 bit, so the number of passes is the number of 1 bits. Read from top to bottom; the notes on the right explain each part.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Each pass of the loop removes the lowest 1 bit, so the number of passes is the number of 1 bits. Read from top to bottom; the notes on the right explain each part.",
      "autoResize": true,
      "lineHeight": 1.25
    },
