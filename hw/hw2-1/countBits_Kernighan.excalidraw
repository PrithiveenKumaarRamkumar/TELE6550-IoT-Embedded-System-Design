    {
      "id": "text-0114",
      "type": "text",
      "x": 1344,
      "y": 1119.5,
      "width": 343.44,
      "height": 30.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "grp-0112"
      ],
      "frameId": null,
      "index": "b0i",
      "roundness": null,
      "seed": 1743065519,
      "version": 1,
      "versionNonce": 135932559,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1790553600000,
      "link": null,
      "locked": false,
      "text": "Example with 12 (binary 1100)",
      "fontSize": 24,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Example with 12 (binary 1100)",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "text-0115",
      "type": "text",
      "x": 1344,
      "y": 1159.5,
      "width": 462.78,
      "height": 135.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "grp-0112"
      ],
      "frameId": null,
      "index": "b0j",
      "roundness": null,
      "seed": 663987871,
      "version": 1,
      "versionNonce": 635713526,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1790553600000,
      "link": null,
      "locked": false,
      "text": "Pass 1: 1100 - 1 = 1011, and 1100 & 1011 = 1000.\nPass 2: 1000 - 1 = 0111, and 1000 & 0111 = 0000.\ninteger is now 0, so the loop stops with count = 2.\n12 has two 1 bits, so the loop ran twice.\nBeside it: 180 = 10110100 has four 1 bits, so the loop\nruns 4 times, removing them one by one from the right.",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Pass 1: 1100 - 1 = 1011, and 1100 & 1011 = 1000.\nPass 2: 1000 - 1 = 0111, and 1000 & 0111 = 0000.\ninteger is now 0, so the loop stops with count = 2.\n12 has two 1 bits, so the loop ran twice.\nBeside it: 180 = 10110100 has four 1 bits, so the loop\nruns 4 times, removing them one by one from the right.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "text-0117",
      "type": "text",
      "x": 20,
      "y": 1101.5,
      "width": 364.6,
      "height": 25.0,
      "angle": 0,
      "strokeColor": "#495057",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "grp-0116"
      ],
      "frameId": null,
      "index": "b0k",
      "roundness": null,
      "seed": 1870137227,
      "version": 1,
      "versionNonce": 1198116409,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1790553600000,
      "link": null,
      "locked": false,
      "text": "The example from the notes: 12 = 1100",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "The example from the notes: 12 = 1100",
      "autoResize": true,
      "lineHeight": 1.25
    },
