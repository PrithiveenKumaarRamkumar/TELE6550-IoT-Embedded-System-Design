      "seed": 1681212595,
      "version": 1,
      "versionNonce": 1076386382,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1790726400000,
      "link": null,
      "locked": false,
      "text": "Why 32 bits for shifted and result?",
      "fontSize": 24,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Why 32 bits for shifted and result?",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "text-0414",
      "type": "text",
      "x": 1344,
      "y": 2243.0,
      "width": 460.62,
      "height": 135.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "grp-0411"
      ],
      "frameId": null,
      "index": "b5T",
      "roundness": null,
      "seed": 1616691409,
      "version": 1,
      "versionNonce": 19464270,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1790726400000,
      "link": null,
      "locked": false,
      "text": "The biggest answer, 65535 × 65535 = 4,294,836,225,\ndoesn't fit in 16 bits (a uint16_t stops at 65,535),\nso result is a uint32_t.\nshifted is 32 bits too: for bit 15 of integer2 it has been\ndoubled 15 times, which moves integer1's top bit up to\nbit 30. In a 16-bit variable those bits would be lost.",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "The biggest answer, 65535 × 65535 = 4,294,836,225,\ndoesn't fit in 16 bits (a uint16_t stops at 65,535),\nso result is a uint32_t.\nshifted is 32 bits too: for bit 15 of integer2 it has been\ndoubled 15 times, which moves integer1's top bit up to\nbit 30. In a 16-bit variable those bits would be lost.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "text-0416",
      "type": "text",
      "x": 20,
      "y": 2185.0,
      "width": 396.4,
      "height": 25.0,
      "angle": 0,
      "strokeColor": "#495057",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b5U",
