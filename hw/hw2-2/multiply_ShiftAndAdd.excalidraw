      "boundElements": null,
      "updated": 1790726400000,
      "link": null,
      "locked": false,
      "text": "uint32_t multiply(uint16_t integer1, uint16_t integer2);",
      "fontSize": 15,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "uint32_t multiply(uint16_t integer1, uint16_t integer2);",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "text-0116",
      "type": "text",
      "x": 1344,
      "y": 243.25,
      "width": 520.56,
      "height": 67.5,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "grp-0111"
      ],
      "frameId": null,
      "index": "b0n",
      "roundness": null,
      "seed": 899621066,
      "version": 1,
      "versionNonce": 1215388812,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1790726400000,
      "link": null,
      "locked": false,
      "text": "that returns integer1 × integer2 without using the * operator,\nand print the result for every combination of numbers\nfrom 0 to 10.",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "that returns integer1 × integer2 without using the * operator,\nand print the result for every combination of numbers\nfrom 0 to 10.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "rect-0118",
