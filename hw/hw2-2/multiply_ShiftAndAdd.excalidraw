      "locked": false
    },
    {
      "id": "text-0119",
      "type": "text",
      "x": 1344,
      "y": 372.75,
      "width": 95.76,
      "height": 30.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
