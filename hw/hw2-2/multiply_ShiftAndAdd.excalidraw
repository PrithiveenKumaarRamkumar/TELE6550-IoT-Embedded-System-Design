      "updated": 1790726400000,
      "link": null,
      "locked": false,
      "text": "The main program: app_main()",
      "fontSize": 24,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "The main program: app_main()",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "text-0557",
      "type": "text",
      "x": 44,
      "y": 2533.0,
      "width": 639.8,
      "height": 140.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "grp-0554"
      ],
      "frameId": null,
      "index": "b7k",
      "roundness": null,
      "seed": 1060416,
      "version": 1,
      "versionNonce": 1876723061,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1790726400000,
      "link": null,
      "locked": false,
      "text": "void app_main(void)\n{\n    for (uint16_t a = 0; a <= 10; a++) {\n        for (uint16_t b = 0; b <= 10; b++) {\n            printf(\"%2u x %2u = %3lu\\n\", a, b, (unsigned long)multiply(a, b));\n        }\n    }\n}",
      "fontSize": 14,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "void app_main(void)\n{\n    for (uint16_t a = 0; a <= 10; a++) {\n        for (uint16_t b = 0; b <= 10; b++) {\n            printf(\"%2u x %2u = %3lu\\n\", a, b, (unsigned long)multiply(a, b));\n        }\n    }\n}",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "text-0558",
      "type": "text",
      "x": 44,
      "y": 2685.0,
      "width": 518.58,
      "height": 112.5,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "grp-0554"
      ],
      "frameId": null,
      "index": "b7l",
      "roundness": null,
      "seed": 256740596,
      "version": 1,
      "versionNonce": 749132475,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1790726400000,
      "link": null,
      "locked": false,
      "text": "• Two nested loops go through every pair (a, b) from 0 to 10:\n   11 × 11 = 121 combinations.\n• %2u and %3lu pad the numbers so the columns line up.\n• The result is cast to unsigned long so it matches %lu\n   for the ESP32's compiler.",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "• Two nested loops go through every pair (a, b) from 0 to 10:\n   11 × 11 = 121 combinations.\n• %2u and %3lu pad the numbers so the columns line up.\n• The result is cast to unsigned long so it matches %lu\n   for the ESP32's compiler.",
      "autoResize": true,
      "lineHeight": 1.25
    },
