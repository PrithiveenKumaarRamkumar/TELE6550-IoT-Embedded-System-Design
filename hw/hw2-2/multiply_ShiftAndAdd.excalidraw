      "boundElements": null,
      "updated": 1790726400000,
      "link": null,
      "locked": false,
      "text": "Long multiplication in binary: for every 1 bit of integer2, add a shifted copy of integer1. Read from top to bottom; the notes on the right explain each part.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Long multiplication in binary: for every 1 bit of integer2, add a shifted copy of integer1. Read from top to bottom; the notes on the right explain each part.",
      "autoResize": true,
      "lineHeight": 1.25
    },
