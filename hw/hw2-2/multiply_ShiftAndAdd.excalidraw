    {
      "id": "text-0413",
      "type": "text",
      "x": 1344,
      "y": 2203.0,
      "width": 389.04,
      "height": 30.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
