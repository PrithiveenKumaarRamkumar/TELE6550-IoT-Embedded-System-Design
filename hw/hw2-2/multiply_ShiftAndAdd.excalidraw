    {
      "id": "text-0222",
      "type": "text",
      "x": 1344,
      "y": 1356,
      "width": 363.84,
      "height": 30.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "grp-0220"
      ],
      "frameId": null,
      "index": "b2R",
      "roundness": null,
      "seed": 339321143,
      "version": 1,
      "versionNonce": 1741730069,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1790726400000,
      "link": null,
      "locked": false,
      "text": "Example: 6 × 5  (5 = binary 101)",
      "fontSize": 24,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Example: 6 × 5  (5 = binary 101)",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "text-0223",
      "type": "text",
      "x": 1344,
      "y": 1396.0,
      "width": 483.84,
      "height": 135.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "grp-0220"
      ],
      "frameId": null,
      "index": "b2S",
      "roundness": null,
      "seed": 1572953820,
      "version": 1,
      "versionNonce": 1953070903,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1790726400000,
      "link": null,
      "locked": false,
      "text": "Pass 1: the lowest bit of 101 is 1, so result = 0 + 6 = 6.\nPass 2: the lowest bit of 10 is 0, so nothing is added.\nPass 3: the lowest bit of 1 is 1, so result = 6 + 24 = 30.\ninteger2 is now 0, so the loop stops: 6 × 5 = 30.\nEvery pass, shifted doubles (6, 12, 24) and integer2 loses\nits lowest bit, whether or not anything was added.",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Pass 1: the lowest bit of 101 is 1, so result = 0 + 6 = 6.\nPass 2: the lowest bit of 10 is 0, so nothing is added.\nPass 3: the lowest bit of 1 is 1, so result = 6 + 24 = 30.\ninteger2 is now 0, so the loop stops: 6 × 5 = 30.\nEvery pass, shifted doubles (6, 12, 24) and integer2 loses\nits lowest bit, whether or not anything was added.",
      "autoResize": true,
      "lineHeight": 1.25
    },
