      "seed": 1397364973,
      "version": 1,
      "versionNonce": 1108962366,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1790726400000,
      "link": null,
      "locked": false,
      "text": "The idea",
      "fontSize": 24,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "The idea",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "text-0120",
      "type": "text",
      "x": 1344,
      "y": 412.75,
      "width": 469.44,
      "height": 225.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "grp-0117"
      ],
      "frameId": null,
      "index": "b0q",
      "roundness": null,
      "seed": 858832272,
      "version": 1,
      "versionNonce": 1702659596,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1790726400000,
      "link": null,
      "locked": false,
      "text": "This is long multiplication done in binary. Any number is\na sum of powers of 2: 5 = 101 = 4 + 1, so\n6 × 5 = 6 × 4 + 6 × 1.\nThe loop goes through the bits of integer2, lowest first:\n• bit is 1: add the current value of shifted to result\n• after each bit, <<= 1 doubles shifted: 6, 12, 24, …\n• >>= 1 shifts integer2 right, so the next bit becomes\n   the lowest one; the loop stops when integer2 is 0\ninteger2 & 1 keeps only the lowest bit: 1 if it is set,\n0 otherwise.",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "This is long multiplication done in binary. Any number is\na sum of powers of 2: 5 = 101 = 4 + 1, so\n6 × 5 = 6 × 4 + 6 × 1.\nThe loop goes through the bits of integer2, lowest first:\n• bit is 1: add the current value of shifted to result\n• after each bit, <<= 1 doubles shifted: 6, 12, 24, …\n• >>= 1 shifts integer2 right, so the next bit becomes\n   the lowest one; the loop stops when integer2 is 0\ninteger2 & 1 keeps only the lowest bit: 1 if it is set,\n0 otherwise.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "rect-0122",
      "type": "rectangle",
      "x": 1320,
      "y": 880,
