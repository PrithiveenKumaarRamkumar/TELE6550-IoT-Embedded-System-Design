    },
    {
      "id": "text-0007",
      "type": "text",
      "x": 44,
      "y": 206.25,
      "width": 631.6,
      "height": 262.5,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "grp-0003"
      ],
      "frameId": null,
      "index": "a5",
      "roundness": null,
      "seed": 2034233523,
      "version": 1,
      "versionNonce": 203282906,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1790726400000,
      "link": null,
      "locked": false,
      "text": "uint32_t multiply(uint16_t integer1, uint16_t integer2)\n{\n    uint32_t result = 0;\n    uint32_t shifted = integer1;   /* 32 bits so the shifts don't overflow */\n\n    while (integer2 != 0) {\n        if (integer2 & 1) {        /* lowest bit of integer2 is 1 */\n            result += shifted;\n        }\n        shifted <<= 1;             /* integer1 x 2, x 4, x 8, ... */\n        integer2 >>= 1;            /* move on to the next bit */\n    }\n\n    return result;\n}",
      "fontSize": 14,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "uint32_t multiply(uint16_t integer1, uint16_t integer2)\n{\n    uint32_t result = 0;\n    uint32_t shifted = integer1;   /* 32 bits so the shifts don't overflow */\n\n    while (integer2 != 0) {\n        if (integer2 & 1) {        /* lowest bit of integer2 is 1 */\n            result += shifted;\n        }\n        shifted <<= 1;             /* integer1 x 2, x 4, x 8, ... */\n        integer2 >>= 1;            /* move on to the next bit */\n    }\n\n    return result;\n}",
      "autoResize": true,
      "lineHeight": 1.25
    },
