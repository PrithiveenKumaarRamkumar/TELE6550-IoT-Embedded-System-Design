    {
      "id": "text-0368",
      "type": "text",
      "x": 1344,
      "y": 1761.0,
      "width": 199.68,
      "height": 30.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
