      "isDeleted": false,
      "boundElements": null,
      "updated": 1790726400000,
      "link": null,
      "locked": false,
      "text": "Each cell shows a + b (what the program prints); its colour\nshows how many passes the loop needed. Row = a, column = b.\nThe outlined cell is the example 5 + 3 = 8.",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
