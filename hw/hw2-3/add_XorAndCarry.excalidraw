      "seed": 365790463,
      "version": 1,
      "versionNonce": 329076512,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1790726400000,
      "link": null,
      "locked": false,
      "text": " 0 +  0 =  0\n 0 +  1 =  1\n 0 +  2 =  2\n...\n 5 +  2 =  7\n 5 +  3 =  8\n 5 +  4 =  9\n...\n10 +  9 = 19\n10 + 10 = 20",
      "fontSize": 16,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": " 0 +  0 =  0\n 0 +  1 =  1\n 0 +  2 =  2\n...\n 5 +  2 =  7\n 5 +  3 =  8\n 5 +  4 =  9\n...\n10 +  9 = 19\n10 + 10 = 20",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "text-0585",
      "type": "text",
      "x": 804,
