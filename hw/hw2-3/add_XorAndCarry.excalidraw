    {
      "id": "text-0584",
      "type": "text",
      "x": 804,
      "y": 2340.0,
      "width": 112.49,
      "height": 200.0,
      "angle": 0,
      "strokeColor": "#b2f2bb",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "grp-0580"
      ],
      "frameId": null,
      "index": "b88",
