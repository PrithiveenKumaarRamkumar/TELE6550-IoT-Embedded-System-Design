      "link": null,
      "locked": false,
      "text": "add(uint16_t, uint16_t) without + or -: the XOR/AND carry method",
      "fontSize": 40,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "add(uint16_t, uint16_t) without + or -: the XOR/AND carry method",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "text-0002",
      "type": "text",
      "x": 20,
      "y": 60,
      "width": 1525.4,
      "height": 25.0,
      "angle": 0,
      "strokeColor": "#495057",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "a1",
      "roundness": null,
      "seed": 1933714182,
      "version": 1,
      "versionNonce": 601828002,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1790726400000,
      "link": null,
      "locked": false,
      "text": "XOR adds the columns, AND finds the carries, << 1 moves them one column left, and the loop repeats until no carry is left. The notes on the right explain each part.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "XOR adds the columns, AND finds the carries, << 1 moves them one column left, and the loop repeats until no carry is left. The notes on the right explain each part.",
      "autoResize": true,
      "lineHeight": 1.25
    },
