    {
      "id": "text-0576",
      "type": "text",
      "x": 44,
      "y": 2303.0,
      "width": 342.0,
      "height": 30.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
