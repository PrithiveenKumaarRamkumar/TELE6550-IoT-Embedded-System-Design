    {
      "id": "text-0191",
      "type": "text",
      "x": 1344,
      "y": 1201.0,
      "width": 332.88,
      "height": 30.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "grp-0189"
      ],
      "frameId": null,
      "index": "b1v",
      "roundness": null,
      "seed": 1280431864,
      "version": 1,
      "versionNonce": 1400745500,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1790726400000,
      "link": null,
      "locked": false,
      "text": "Example: 5 + 3  (0101 + 0011)",
      "fontSize": 24,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Example: 5 + 3  (0101 + 0011)",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "text-0192",
      "type": "text",
      "x": 1344,
      "y": 1241.0,
      "width": 500.04,
      "height": 157.5,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "grp-0189"
      ],
      "frameId": null,
      "index": "b1w",
      "roundness": null,
      "seed": 272540564,
      "version": 1,
      "versionNonce": 1723968273,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1790726400000,
      "link": null,
      "locked": false,
      "text": "Pass 1: column 0 has 1 + 1, so it keeps 0 and carries 1.\nPasses 2 and 3: the carry lands on another 1 and moves on.\nPass 4: the carry lands in an empty column and stays.\ncarry is now 0, so the loop stops: 1000 = 8.\nWhy it works: sum ^ carry plus (sum & carry) << 1 always\nequals sum + carry, so the total stays 8 while the carries\nmove left until none are left.",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Pass 1: column 0 has 1 + 1, so it keeps 0 and carries 1.\nPasses 2 and 3: the carry lands on another 1 and moves on.\nPass 4: the carry lands in an empty column and stays.\ncarry is now 0, so the loop stops: 1000 = 8.\nWhy it works: sum ^ carry plus (sum & carry) << 1 always\nequals sum + carry, so the total stays 8 while the carries\nmove left until none are left.",
      "autoResize": true,
      "lineHeight": 1.25
    },
