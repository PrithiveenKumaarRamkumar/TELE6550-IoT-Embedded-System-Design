      "isDeleted": false,
      "boundElements": null,
      "updated": 1790726400000,
      "link": null,
      "locked": false,
      "text": "Row 1: the biggest answer (131,070).   Row 2: 65535 + 1, where the carry ends up in bit 16.",
      "fontSize": 15,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Row 1: the biggest answer (131,070).   Row 2: 65535 + 1, where the carry ends up in bit 16.",
      "autoResize": true,
      "lineHeight": 1.25
    },
