      "seed": 2143748369,
      "version": 1,
      "versionNonce": 714351316,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1790726400000,
      "link": null,
      "locked": false,
      "text": "The main program: app_main()",
      "fontSize": 24,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "The main program: app_main()",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "text-0577",
      "type": "text",
      "x": 44,
      "y": 2343.0,
      "width": 598.79,
      "height": 140.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "grp-0574"
      ],
      "frameId": null,
      "index": "b82",
      "roundness": null,
      "seed": 234215906,
      "version": 1,
      "versionNonce": 1974392193,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1790726400000,
      "link": null,
      "locked": false,
      "text": "void app_main(void)\n{\n    for (uint16_t a = 0; a <= 10; a++) {\n        for (uint16_t b = 0; b <= 10; b++) {\n            printf(\"%2u + %2u = %2lu\\n\", a, b, (unsigned long)add(a, b));\n        }\n    }\n}",
      "fontSize": 14,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "void app_main(void)\n{\n    for (uint16_t a = 0; a <= 10; a++) {\n        for (uint16_t b = 0; b <= 10; b++) {\n            printf(\"%2u + %2u = %2lu\\n\", a, b, (unsigned long)add(a, b));\n        }\n    }\n}",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "text-0578",
      "type": "text",
      "x": 44,
      "y": 2495.0,
      "width": 518.58,
      "height": 180.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "grp-0574"
      ],
      "frameId": null,
      "index": "b83",
      "roundness": null,
      "seed": 1275046784,
      "version": 1,
      "versionNonce": 291120035,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1790726400000,
      "link": null,
      "locked": false,
      "text": "• Two nested loops go through every pair (a, b) from 0 to 10:\n   11 × 11 = 121 combinations.\n• %2u and %2lu pad the numbers so the columns line up.\n• The result is cast to unsigned long so it matches %lu\n   for the ESP32's compiler.\n• Note: a++ and b++ use addition. The task only restricts\n   the add() function. If no + is allowed anywhere, change\n   them to a = add(a, 1) and b = add(b, 1):",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "• Two nested loops go through every pair (a, b) from 0 to 10:\n   11 × 11 = 121 combinations.\n• %2u and %2lu pad the numbers so the columns line up.\n• The result is cast to unsigned long so it matches %lu\n   for the ESP32's compiler.\n• Note: a++ and b++ use addition. The task only restricts\n   the add() function. If no + is allowed anywhere, change\n   them to a = add(a, 1) and b = add(b, 1):",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "text-0579",
      "type": "text",
      "x": 44,
      "y": 2687.0,
      "width": 410.13,
      "height": 35.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "grp-0574"
      ],
      "frameId": null,
      "index": "b84",
      "roundness": null,
      "seed": 304845248,
      "version": 1,
      "versionNonce": 1850730198,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1790726400000,
      "link": null,
      "locked": false,
      "text": "for (uint16_t a = 0; a <= 10; a = add(a, 1)) {\n    for (uint16_t b = 0; b <= 10; b = add(b, 1)) {",
      "fontSize": 14,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "for (uint16_t a = 0; a <= 10; a = add(a, 1)) {\n    for (uint16_t b = 0; b <= 10; b = add(b, 1)) {",
      "autoResize": true,
      "lineHeight": 1.25
    },
