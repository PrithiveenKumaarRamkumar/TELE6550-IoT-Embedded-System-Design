    },
    {
      "id": "text-0007",
      "type": "text",
      "x": 44,
      "y": 206.25,
      "width": 631.6,
      "height": 227.5,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "grp-0003"
      ],
      "frameId": null,
      "index": "a5",
      "roundness": null,
      "seed": 2034233523,
      "version": 1,
      "versionNonce": 203282906,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1790726400000,
      "link": null,
      "locked": false,
      "text": "uint32_t add(uint16_t integer1, uint16_t integer2)\n{\n    uint32_t sum = integer1;\n    uint32_t carry = integer2;\n\n    while (carry != 0) {\n        uint32_t carries = (sum & carry) << 1;   /* columns that carry a 1 */\n        sum = sum ^ carry;                       /* add without carrying   */\n        carry = carries;                         /* add the carries next   */\n    }\n\n    return sum;\n}",
      "fontSize": 14,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "uint32_t add(uint16_t integer1, uint16_t integer2)\n{\n    uint32_t sum = integer1;\n    uint32_t carry = integer2;\n\n    while (carry != 0) {\n        uint32_t carries = (sum & carry) << 1;   /* columns that carry a 1 */\n        sum = sum ^ carry;                       /* add without carrying   */\n        carry = carries;                         /* add the carries next   */\n    }\n\n    return sum;\n}",
      "autoResize": true,
      "lineHeight": 1.25
    },
