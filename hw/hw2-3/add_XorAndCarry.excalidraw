      "isDeleted": false,
      "boundElements": null,
      "updated": 1790726400000,
      "link": null,
      "locked": false,
      "text": "Why 32 bits for sum and carry?",
      "fontSize": 24,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Why 32 bits for sum and carry?",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "text-0434",
      "type": "text",
      "x": 1344,
      "y": 2053.0,
      "width": 513.18,
      "height": 90.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "grp-0431"
      ],
      "frameId": null,
      "index": "b5l",
      "roundness": null,
      "seed": 517809839,
      "version": 1,
      "versionNonce": 467882550,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1790726400000,
      "link": null,
      "locked": false,
      "text": "The biggest answer, 65535 + 65535 = 131,070, needs 17 bits,\nwhich is more than a uint16_t holds (16 bits, max 65,535).\nThe carry can reach bit 16 too: in 65535 + 1 it walks all\nthe way from bit 0 up to bit 16. A uint32_t has room for both.",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "The biggest answer, 65535 + 65535 = 131,070, needs 17 bits,\nwhich is more than a uint16_t holds (16 bits, max 65,535).\nThe carry can reach bit 16 too: in 65535 + 1 it walks all\nthe way from bit 0 up to bit 16. A uint32_t has room for both.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "text-0436",
      "type": "text",
      "x": 20,
      "y": 1995.0,
      "width": 321.4,
      "height": 25.0,
      "angle": 0,
      "strokeColor": "#495057",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b5m",
      "roundness": null,
      "seed": 1326052840,
      "version": 1,
      "versionNonce": 1072251445,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1790726400000,
      "link": null,
      "locked": false,
      "text": "The biggest values need a 17th bit",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "The biggest values need a 17th bit",
      "autoResize": true,
      "lineHeight": 1.25
    },
