      "index": "b5S",
      "roundness": null,
      "seed": 1681212595,
      "version": 1,
      "versionNonce": 1076386382,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1790726400000,
      "link": null,
      "locked": false,
      "text": "7 + 0",
      "fontSize": 16,
      "fontFamily": 3,
      "textAlign": "left",
