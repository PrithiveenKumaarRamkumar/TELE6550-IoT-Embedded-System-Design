    },
    {
      "id": "text-0407",
      "type": "text",
      "x": 900,
      "y": 1451.0,
      "width": 267.0,
      "height": 75.0,
      "angle": 0,
      "strokeColor": "#495057",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "grp-0366"
      ],
      "frameId": null,
      "index": "b5N",
      "roundness": null,
      "seed": 1057488634,
      "version": 1,
      "versionNonce": 1938942858,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1790726400000,
      "link": null,
      "locked": false,
      "text": "One carry ripples through the columns\n0 → 1 → 2 → 3. The loop moves it one\ncolumn per pass (passes 1 to 3), and\npass 4 adds it in.",
      "fontSize": 15,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "One carry ripples through the columns\n0 → 1 → 2 → 3. The loop moves it one\ncolumn per pass (passes 1 to 3), and\npass 4 adds it in.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "rect-0409",
      "type": "rectangle",
      "x": 1320,
      "y": 1627.0,
      "width": 700,
      "height": 258.0,
      "angle": 0,
      "strokeColor": "#495057",
      "backgroundColor": "#f8f9fa",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "grp-0408"
      ],
      "frameId": null,
      "index": "b5O",
      "roundness": {
        "type": 3
      },
      "seed": 1359616458,
      "version": 1,
      "versionNonce": 1174176852,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1790726400000,
      "link": null,
      "locked": false
    },
    {
      "id": "text-0410",
      "type": "text",
      "x": 1344,
      "y": 1645.0,
      "width": 199.68,
      "height": 30.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "grp-0408"
      ],
      "frameId": null,
      "index": "b5P",
      "roundness": null,
      "seed": 1363955933,
      "version": 1,
      "versionNonce": 999033583,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1790726400000,
      "link": null,
      "locked": false,
      "text": "Why it is efficient",
      "fontSize": 24,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Why it is efficient",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "text-0411",
      "type": "text",
      "x": 1344,
      "y": 1685.0,
      "width": 511.02,
      "height": 180.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "grp-0408"
      ],
      "frameId": null,
      "index": "b5Q",
      "roundness": null,
      "seed": 1943836836,
      "version": 1,
      "versionNonce": 1694885614,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1790726400000,
      "link": null,
      "locked": false,
      "text": "• Each pass is just an AND, a shift and an XOR, so the work\n   happens across all 16 bits at once.\n• The loop runs once for each time a carry has to move\n   further left, not once per bit. Many sums finish in 1 or 2\n   passes, and 5 + 3 took 4.\n• The worst case is 17 passes, for something like\n   65535 + 1, where the carry moves through every bit.\n• If integer2 is 0, the loop doesn't run at all.",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "• Each pass is just an AND, a shift and an XOR, so the work\n   happens across all 16 bits at once.\n• The loop runs once for each time a carry has to move\n   further left, not once per bit. Many sums finish in 1 or 2\n   passes, and 5 + 3 took 4.\n• The worst case is 17 passes, for something like\n   65535 + 1, where the carry moves through every bit.\n• If integer2 is 0, the loop doesn't run at all.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "text-0413",
      "type": "text",
      "x": 20,
      "y": 1627.0,
      "width": 266.2,
      "height": 25.0,
      "angle": 0,
      "strokeColor": "#495057",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b5R",
      "roundness": null,
      "seed": 1950365599,
      "version": 1,
      "versionNonce": 739241327,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1790726400000,
      "link": null,
      "locked": false,
      "text": "Loop passes for a few sums",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Loop passes for a few sums",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "text-0414",
      "type": "text",
      "x": 20,
      "y": 1673.0,
      "width": 46.87,
      "height": 20.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
